{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "ignite",
      "camelcase": "Ignite",
      "scope": "source.ignite",
      "path": ".",
      "file-types": [
        "ignite"
      ],
      "highlights": [
        "queries/highlights.scm"
      ]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "description": "Ignite grammar for tree-sitter",
    "authors": [
      {
        "name": "codewandler"
      }
    ],
    "links": {
      "repository": "https://github.com/ignite-lang/ignite-helix"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
